# Application
PORT=3000
NODE_ENV=development

# Master Database (stores customer configs and schema mappings)
MASTER_DB_HOST=localhost
MASTER_DB_PORT=5432
MASTER_DB_USERNAME=postgres
MASTER_DB_PASSWORD=postgres
MASTER_DB_DATABASE=master_onboarding

# Default Customer Database (for development/testing)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=data_onboarding

# Kafka
KAFKA_CLIENT_ID=data-onboarding-api
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=data-onboarding-consumer
KAFKA_SITE_TOPIC=site-onboarding
KAFKA_BUILDING_TOPIC=building-onboarding
